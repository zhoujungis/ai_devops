# ============================================================================
# AI DevOps / QA Copilot - environment template
# Copy to .env at the repository root and fill in real values.
#   Windows:  copy .env.example .env
# ============================================================================

# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ---- Database (PostgreSQL + pgvector) ----
# Local path  : PostgreSQL 18 running inside WSL2, reachable from Windows on 127.0.0.1
# Docker path : service name "db" from docker-compose
DB_NAME=ai_devops
DB_USER=copilot
DB_PASSWORD=copilot_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ---- Redis / Celery ----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---- Auth (JWT) ----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- CORS (browser clients only; the terminal client does not need this) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Field encryption (git tokens, AI provider keys) ----
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---- AI providers (optional in S0; used from S4 onwards) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
